{
  "kind": "collectionType",
  "collectionName": "legal_pages",
  "info": {
    "singularName": "legal-page",
    "pluralName": "legal-pages",
    "displayName": "Legal Page",
    "description": "Páginas legales (políticas, legales, simulaciones) editables desde el CMS"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "titulo": {
      "type": "string",
      "required": true
    },
    "bajada": {
      "type": "text"
    },
    "contenido": {
      "type": "richtext"
    },
    "simulaciones": {
      "type": "component",
      "repeatable": true,
      "component": "legal.financing-sim"
    },
    "fecha_vigencia": {
      "type": "date"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
