{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Contenido editorial de la home"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "hero_eyebrow": {
      "type": "component",
      "component": "shared.eyebrow-tri",
      "repeatable": false
    },
    "hero_title": {
      "type": "string",
      "default": "Bienvenidos a SOUEAST Chile"
    },
    "hero_cta_label": {
      "type": "string",
      "default": "CONOCE MÁS"
    },
    "hero_cta_href": {
      "type": "string",
      "default": "modelo-s06.html"
    },
    "hero_video_pc": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "hero_video_mobile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "hero_video_poster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "modelos_section_title": {
      "type": "string",
      "default": "Modelos"
    },
    "modelos_destacados": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::modelo.modelo"
    },
    "modelos_default_tag": {
      "type": "string",
      "default": "Lanzamiento"
    },
    "noticias_section_title": {
      "type": "string",
      "default": "Noticias"
    },
    "noticias_ver_todas_label": {
      "type": "string",
      "default": "VER TODAS"
    },
    "quehacer_items": {
      "type": "component",
      "component": "home.action-card",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
