      "type": "text"
    },
    "mensaje_exito_cta_label": {
      "type": "string",
      "default": "Enviar otra consulta"
    },
    "footer_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "seo": {
