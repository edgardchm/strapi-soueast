{
  "kind": "collectionType",
  "collectionName": "modelo_versions",
  "info": {
    "singularName": "modelo-version",
    "pluralName": "modelo-versions",
    "displayName": "Modelo Version",
    "description": "Versiones y precios por modelo"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "marca": {
      "type": "string",
      "required": true
    },
    "modelo_nombre": {
      "type": "string",
      "required": true
    },
    "version": {
      "type": "string",
      "required": true
    },
    "codigo": {
      "type": "string"
    },
    "precio_lista": {
      "type": "integer",
      "min": 0
    },
    "bono_marca": {
      "type": "integer",
      "min": 0
    },
    "bono_financiamiento": {
      "type": "integer",
      "min": 0
    },
    "precio_final": {
      "type": "integer",
      "min": 0
    },
    "moneda": {
      "type": "enumeration",
      "enum": [
        "CLP",
        "USD",
        "UF"
      ]
    },
    "activo": {
      "type": "boolean"
    },
    "metadata": {
      "type": "json"
    },
    "modelo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::modelo.modelo",
      "inversedBy": "versiones_detalladas"
    }
  }
}
