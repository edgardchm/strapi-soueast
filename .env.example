# strapi/.env.example — copialo a strapi/.env y editá los valores
# Strapi v4 requiere todas estas variables para arrancar.

HOST=0.0.0.0
PORT=1337

# Claves — generá nuevas en producción con:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=tu-app-key-1,tu-app-key-2,tu-app-key-3,tu-app-key-4
API_TOKEN_SALT=tu-api-token-salt
ADMIN_JWT_SECRET=tu-admin-jwt-secret
TRANSFER_TOKEN_SALT=tu-transfer-token-salt
JWT_SECRET=tu-jwt-secret

# Base de datos ────────────────────────────────────────
# Local: SQLite (sin setup). Producción: Postgres.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# DATABASE_CLIENT=postgres
# Opción A (Railway/Heroku): referenciá DATABASE_URL del servicio Postgres — no uses localhost.
# DATABASE_URL=postgresql://...
# Opción B: variables sueltas (o PGHOST/PGUSER/PGPASSWORD/PGDATABASE que inyecta Railway).
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=soueast_cms
# DATABASE_USERNAME=soueast
# DATABASE_PASSWORD=
# Si el hosting exige TLS: DATABASE_SSL=true y a menudo DATABASE_SSL_REJECT_UNAUTHORIZED=false

# CORS — orígenes extra (coma-separados). Además, el middleware permite por defecto
# cualquier https://*.netlify.app (previews y deploys). Dominio custom propio:
#   FRONTEND_ORIGINS=https://www.soueast.cl,https://soueast.cl

FRONTEND_ORIGINS=

# Seeds opcionales (idempotentes) ────────────────────
SEED_MODELOS=true
SEED_SUCURSALES=true
SEED_FOOTER=true
SEED_GLOBAL=true
SEED_HOME=true
SEED_NOTICIAS=true
SEED_NOTICIAS_PAGE=true
SEED_CONTACTO_PAGE=true
SEED_COTIZADOR_PAGE=true
SEED_GRACIAS_PAGE=true
